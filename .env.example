# .env.example

# Backend
# URL interna para Server Actions y proxy de medios (/backend/*)
BACKEND_URL=http://localhost:8000
# URL pública del backend (HTTPS) para normalizar URLs absolutas de audio
PUBLIC_BACKEND_URL=https://sonara-api.example.com

# JWT
JWT_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=30

# Better Auth (si lo usas)
BETTER_AUTH_SECRET=tu_clave_secreta_de_32_caracteres_minimo

# Cookies Secure
# true  -> si el sitio se sirve por HTTPS
# false -> si producción es HTTP (red interna, sin TLS)
# En development el valor por defecto es false; en production, true.
COOKIE_SECURE=false

# Node environment
NODE_ENV=development